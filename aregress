#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$SCRIPT_DIR/target/aregress-1.0-SNAPSHOT.jar"

if [[ ! -f "$JAR" ]]; then
    echo "error: JAR not found at $JAR" >&2
    echo "       Run 'mvn package' first." >&2
    exit 1
fi

# Require Java 17+
JAVA_MAJOR=$(java -version 2>&1 | grep -m1 'version' | sed 's/.*"\([0-9]*\).*/\1/')
if (( JAVA_MAJOR < 17 )); then
    echo "error: Java 17+ required (found Java $JAVA_MAJOR)" >&2
    echo "       Set JAVA_HOME to a suitable JDK, or run: sdk use java 17.0.18-tem" >&2
    exit 1
fi

exec java -jar "$JAR" "$@"
