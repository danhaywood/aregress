#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$SCRIPT_DIR/target/aregress-1.0-SNAPSHOT.jar"

if [[ ! -f "$JAR" ]]; then
    echo "error: JAR not found at $JAR" >&2
    echo "       Run 'mvn package' first." >&2
    exit 1
fi

# Require Java 17+
JAVA_VERSION_OUTPUT=$(java -version 2>&1 || true)
# Extract the major version: anchor on `version "` so the greedy `.*` can't
# swallow past the first quote (which would leave the capture empty).
JAVA_MAJOR=$(printf '%s\n' "$JAVA_VERSION_OUTPUT" | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p' | head -1)
if [[ -z "$JAVA_MAJOR" ]]; then
    echo "error: could not determine the Java version (is 'java' on PATH?)" >&2
    echo "$JAVA_VERSION_OUTPUT" >&2
    echo "       Set JAVA_HOME to a Java 17+ JDK, or run: sdk use java 17.0.18-tem" >&2
    exit 1
fi
if (( JAVA_MAJOR < 17 )); then
    echo "error: Java 17+ required (found Java $JAVA_MAJOR)" >&2
    echo "       Set JAVA_HOME to a suitable JDK, or run: sdk use java 17.0.18-tem" >&2
    exit 1
fi

exec java -jar "$JAR" "$@"
